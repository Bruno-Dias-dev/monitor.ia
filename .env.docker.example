# Banco usado pelo container mysql e pela API de avaliacoes
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=monitor
MYSQL_PASSWORD=altere-esta-senha
MYSQL_DATABASE=monitor_ia
MYSQL_ROOT_PASSWORD=altere-a-senha-root

# database.py ainda exige este nome de variavel para a porta.
DB_PORT2=3306

# Banco usado pelo login.py (pode ser o mesmo banco acima)
DB_HOST=mysql
DB_PORT=3306
DB_USER=monitor
DB_PASSWORD=altere-esta-senha
DB_NAME=monitor_ia

# Credenciais e integracoes externas
JWT_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
JWT_ACCESS_TOKEN_EXPIRES_HOURS=4
GOOGLE_GENAI_API_KEY=
CHATWOOT_API_URL=
CHATWOOT_API_TOKEN=
GOSAC_API_URL=
GOSAC_API_TOKEN=
GOSAC_START_PERIOD=
GOSAC_END_PERIOD=
EXCEL_URL=

# Mantido para execucao fora do Docker; app.py hoje fixa estas origens no codigo.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
