# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=usuario
MYSQL_PASSWORD=senha
MYSQL_DATABASE=nome_banco

# JWT: use uma chave longa e aleatória em produção.
JWT_SECRET_KEY=troque-por-uma-chave-secreta-segura
JWT_ACCESS_TOKEN_EXPIRES_HOURS=4
CORS_ORIGINS=http://127.0.0.1:5500
FLASK_DEBUG=true
